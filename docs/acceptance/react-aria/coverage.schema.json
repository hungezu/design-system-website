{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guokexin.example/schemas/react-aria-coverage-1.json",
  "title": "React Aria 组件家族覆盖清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "families", "infrastructure"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "react-aria-coverage/1" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "auditedVersion", "auditedAt", "countingRule", "familyCount", "infrastructureCount", "expectedCoverage", "projectPhaseOneFamilyIds", "projectPhaseTwoFamilyIds", "projectPhaseThreeFamilyIds"],
      "properties": {
        "package": { "const": "react-aria-components" },
        "auditedVersion": { "type": "string" },
        "auditedAt": { "type": "string", "format": "date" },
        "countingRule": { "type": "string", "minLength": 1 },
        "familyCount": { "const": 54 },
        "infrastructureCount": { "const": 6 },
        "expectedCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicCovered", "projectApproved"],
          "properties": {
            "publicCovered": { "type": "integer", "minimum": 0, "maximum": 54 },
            "projectApproved": { "type": "integer", "minimum": 0, "maximum": 54 }
          }
        },
        "projectPhaseOneFamilyIds": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "projectPhaseTwoFamilyIds": { "type": "array", "minItems": 23, "maxItems": 23, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "projectPhaseThreeFamilyIds": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "families": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "public"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "public": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "componentIds"],
            "properties": {
              "mode": { "enum": ["direct", "composite", "semantic-equivalent", "planned"] },
              "componentIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "infrastructure": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "businessComponent", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "businessComponent": { "const": false },
          "status": { "enum": ["direct", "composite", "semantic-equivalent", "partial", "unsupported", "planned"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
